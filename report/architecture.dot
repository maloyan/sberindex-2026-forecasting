// Left to right, one column per stage, no crossing edges. Render: dot -Tpng -Gdpi=170 architecture.dot -o figures/fig_architecture.png
digraph G {
  rankdir=LR; splines=ortho; nodesep=0.25; ranksep=0.45; newrank=true;
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#4a5568", fillcolor="#f7fafc", width=2.3];
  edge [color="#718096", arrowsize=0.7];

  sber [label="СберИндекс\n12 096 рядов, 24 мес.", fillcolor="#e6fffa"];
  ros  [label="Росстат: годовой\nрост розницы (лаг 2 мес.)"];
  news [label="Новости GDELT +\nреестр ЧС (as-of)"];

  nat  [label="1. Ритм страны n\nмедиана по МО + рост", fillcolor="#fefcbf"];
  loc  [label="2. Отклонение города\nd = log y - n", fillcolor="#ebf4ff"];
  cpd  [label="4. Сторож: детекторы\nсдвигов на d", fillcolor="#fff5f5"];

  mods [label="Модели для d:\nFM, GBM, классика,\nнаивные (35 кубов)", fillcolor="#ebf4ff"];
  ens  [label="3. Ансамбль Caruana\nвеса на validation", fillcolor="#f0fff4"];
  out  [label="Прогноз 2025\n+ 80% интервал\n+ сигналы сдвигов", fillcolor="#f0fff4"];

  {rank=same; sber; ros; news}
  {rank=same; nat; loc; cpd}
  ros -> nat; sber -> nat; sber -> loc; news -> cpd;
  loc -> mods; nat -> ens; mods -> ens; cpd -> out; ens -> out;
  loc -> cpd [style=dashed];
}
